# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the deploy's release record (foldrun-infra/dev/ci/changelog.mjs) — written at build, never committed
/release.json
/release.json.tmp

# the assistant's docs, written before `next build` in the image (scripts/assistant-docs.mjs) — never committed
/assistant-docs.json

# foldrun-admin (private: billing, support views, the app's side of the
# operator console's admin API, Stripe) is laid over
# this checkout by its overlay.sh for a hosted build. Never commit its files:
# scripts/billing-guard.mjs refuses them in pre-commit, pre-push and CI.
/app/api/billing/
/app/api/support/
/app/dashboard/billing/
/app/dashboard/wallet/
/app/support/
/server/admin-api/
/server/stripe.ts
/server/stripe-webhook.ts
/components/billing-details-form.tsx
/components/low-balance-banner.tsx
/components/balance-pill.tsx
/components/dunning-banner.tsx
/components/manage-in-stripe.tsx
/components/support-banner.tsx
/tests/admin-export.test.ts
/tests/billing-admin.test.ts
/tests/billing-checkout.test.ts
/tests/stripe-e2e.test.ts
/tests/console-e2e.test.ts
/tests/console-access-keys.ts
/tests/billing-notices-billing.test.ts
/tests/consistency-billing.test.ts
/tests/flags-routes.test.ts
/tests/status-routes.test.ts
/tests/stripe.test.ts
/tests/support-view.test.ts
/tests/admin-api-contract.test.ts
/tests/admin-op.ts
/.foldrun-admin-laid

# The quality stack: its secrets and its reports (quality/run.sh)
/quality/.state
/quality/reports
