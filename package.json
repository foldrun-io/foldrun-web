{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "FOLDRUN_DATA=../data FOLDRUN_DEV_NO_AUTH=1 next dev -p 3900",
    "build": "next build",
    "start": "FOLDRUN_DATA=../data next start -p 3900",
    "lint": "eslint",
    "test": "FOLDRUN_DATA=$(mktemp -d /tmp/foldrun-test-XXXXXX) node --import ./tests/register.mjs --test $(ls tests/*.test.ts | grep -v e2e)",
    "api": "FOLDRUN_API_E2E=1 node --import ./tests/register.mjs --test --test-timeout=300000 tests/api-e2e.test.ts",
    "prepare": "(test ! -f .githooks/install.sh || sh .githooks/install.sh)"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-force": "^3.0.10",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "js-yaml": "^5.5.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
